# Base URL of the KAVACH FastAPI backend (uvicorn app.main:app).
# Leave blank to use the Vite dev proxy (/api -> VITE_DEV_PROXY_TARGET).
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api during `npm run dev`.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Phase 6 (GET/POST /api/optimization/tomato/runs/{id}...) is implemented and
# live on the backend. Keep false to use the real API; set true only to force
# the local mock fixtures (e.g. demoing the UI with the backend offline).
VITE_MOCK_OPTIMIZATION=false
